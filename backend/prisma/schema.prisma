//   تعريف قاعدة البيانات ونوعها
datasource db {  
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  avatar    String? 
  budget    Float?

  expenses  Expense[]
  categories Category[]
  fixedExpenses FixedExpense[]
  createdAt DateTime  @default(now())
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String

  userId    Int?
  user      User?     @relation(fields: [userId], references: [id])
  
  expenses  Expense[]
   fixedExpenses FixedExpense[] 
  @@unique([name, userId]) //لمنع تكرار الفئات
}

model Expense {
  id        Int       @id @default(autoincrement())
  title     String
  amount    Float
  date      DateTime  @default(now())

  categoryId  Int
  userId    Int

  category    Category  @relation(fields: [categoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model FixedExpense {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  categoryId Int
  amount     Float
  dayOfMonth Int       // اليوم اللي ينخصم فيه المصروف
  duration   Int       // عدد الأشهر اللي رح يستمر السحب
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id])
  category   Category  @relation(fields: [categoryId], references: [id])
}
